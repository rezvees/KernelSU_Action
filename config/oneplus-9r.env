# OnePlus 9R profile for KernelSU Action
# Corrected to the official LineageOS sm8250 upstream tree.
CONFIG_ENV=config/oneplus-9r.env

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=lineage-21
KERNEL_CONFIG=defconfig
KERNEL_IMAGE_NAME=Image
KERNEL_NAME=lemonades

KSU_VARIANT=kernelsu-next
KSU_REF=legacy

ENABLE_PATH_UMOUNT=true
ENABLE_SUSFS=true
SUSFS_BRANCH=
KSU_HOOK_MODE=manual
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

USE_CUSTOM_CLANG=false
ENABLE_CCACHE=false
