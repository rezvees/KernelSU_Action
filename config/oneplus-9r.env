CONFIG_ENV=config/oneplus-sm8250.env

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=lineage-21
KERNEL_CONFIG=vendor/wayne_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KERNEL_NAME=lemonades
ADD_LOCALVERSION_TO_FILENAME=false

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_LLVM=false

KSU_VARIANT=resukisu
KSU_REF=
KSU_HOOK_MODE=auto

ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false
