# OnePlus 9R profile for KernelSU Action
# Created to build vendor/lemonades (OnePlus 9R) without changing repo default
CONFIG_ENV=config/oneplus-9r.env

KERNEL_SOURCE=https://github.com/OnePlus-9R/kernel_oneplus_sm8250-9R
KERNEL_SOURCE_BRANCH=lineage-21
KERNEL_CONFIG=vendor/lemonades_user_defconfig
KERNEL_IMAGE_NAME=Image
KERNEL_NAME=lemonades

KSU_VARIANT=kernelsu-next
KSU_REF=legacy

ENABLE_PATH_UMOUNT=true
ENABLE_SUSFS=true
SUSFS_BRANCH=
KSU_HOOK_MODE=manual
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

USE_CUSTOM_CLANG=false
ENABLE_CCACHE=false
