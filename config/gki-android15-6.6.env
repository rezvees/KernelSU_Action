# ===== Device / kernel source (REPLACE these with your exact kernel repo + branch) =====
https://github.com/OnePlus-9R/kernel_oneplus_sm8250-9R
KERNEL_SOURCE_BRANCH: lineage-21
KERNEL_CONFIG=vendor/lemonades_user_defconfig
KERNEL_IMAGE_NAME=Image
DEVICE=lemonades

# ===== KernelSU (you said ksunext) =====
KSU_VARIANT=kernelsu-next
KSU_REF=legacy           # use 'legacy' for older/non-GKI kernels like 4.19

# ===== Backports / patches for older kernels =====
ENABLE_PATH_UMOUNT=true  # required for kernels < 5.9 (4.19 needs this)
ENABLE_SUSFS=true        # optional, but common for root hiding
SUSFS_BRANCH=            # leave empty to auto-select kernel-4.19 mapping

# ===== Hook mode / extra options =====
KSU_HOOK_MODE=manual     # use manual on old kernels if kprobes are flaky
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ===== Toolchain / build niceties =====
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
ENABLE_CCACHE=false
