# Device / kernel source
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8250.git
KERNEL_SOURCE_BRANCH=lineage-21
KERNEL_CONFIG=vendor/lemonades_user_defconfig
KERNEL_IMAGE_NAME=Image

# KernelSU
KSU_VARIANT=kernelsu
KSU_REF=

# For 4.19 kernels, keep this ON
ENABLE_PATH_UMOUNT=true

# Optional, common for this repo
ENABLE_SUSFS=true

# Useful if your kernel is old / hooks fail
KSU_HOOK_MODE=manual
