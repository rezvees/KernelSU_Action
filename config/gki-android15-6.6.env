# OnePlus 9R: legacy Non-GKI kernel (Linux 4.19) with SUSFS, KernelSU-Next, and NetHunter.
# Target Platform: SM8250 (lemonades)

CONFIG_ENV=config/oneplus9r-4.19-ksunext-nethunter.env

# Official OnePlus / LineageOS / Custom Android 14 tree source for SM8250
KERNEL_SOURCE=https://github.com
KERNEL_SOURCE_BRANCH=lineage-21
KERNEL_CONFIG=vendor/lemonades_user_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=NoName-NetHunter

# SM8250 4.19 trees compile properly with stable Clang toolchains
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:LD=ld.lld

# Switched variant to KernelSU Next
KSU_VARIANT=kernelsu-next
KSU_REF=builtin
# Manual hooks are used as kprobes on 4.19 kernels are prone to instability
KSU_HOOK_MODE=manual
ENABLE_KPM=false

ENABLE_SUSFS=true
SUSFS_BRANCH=auto

# Required backport: 4.19 predates path_umount() (introduced in 5.9)
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# Kali NetHunter core networking & wireless monitoring configurations
EXTRA_DEFCONFIG=CONFIG_WLAN=y CONFIG_WIRELESS_EXT=y CONFIG_WEXT_CORE=y CONFIG_WEXT_PROC=y CONFIG_WEXT_SPY=y CONFIG_WEXT_PRIV=y CONFIG_CFG80211=y CONFIG_CFG80211_WEXT=y CONFIG_MAC80211=y CONFIG_NETFILTER=y CONFIG_NETFILTER_XT_TARGET=y CONFIG_IP_NF_TARGET=y

# Independent Device Tree Blob handling for modern SM8250 zip flashes
NEED_DTBO=true
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
