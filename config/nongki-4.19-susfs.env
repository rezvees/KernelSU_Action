# OnePlus 9R (lemonades, SM8250) — Non-GKI kernel (Linux 4.19) with SUSFS, KernelSU-Next, NetHunter.
# Target: Android 14 (LineageOS 21)

CONFIG_ENV=config/oneplus9r-4.19-ksunext-nethunter.env

# Kernel source: choose the repo that contains the lemonades defconfig and the tree for Android 14
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=lineage-21
# defconfig: adjust if your chosen tree uses vendor/lemonades_user_defconfig instead
KERNEL_CONFIG=lemonades_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=OnePlus9R-NetHunter

# Toolchain: recommended for 4.19
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false            # fully-LLVM builds often break on 4.x trees; set true only if you've tested it
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld

# KernelSU (next) pinned for legacy kernels
KSU_VARIANT=kernelsu-next
KSU_REF=legacy
# Manual hooks are safer on 4.19
KSU_HOOK_MODE=manual
ENABLE_KPM=false

# SUSFS
ENABLE_SUSFS=true
SUSFS_BRANCH=auto

# Required backport & extra options for old kernels
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# NetHunter / wireless flags (example; adjust or remove if you manage defconfig elsewhere)
EXTRA_DEFCONFIG="CONFIG_WLAN=y CONFIG_WIRELESS_EXT=y CONFIG_WEXT_CORE=y CONFIG_WEXT_PROC=y CONFIG_WEXT_SPY=y CONFIG_WEXT_PRIV=y CONFIG_CFG80211=y CONFIG_CFG80211_WEXT=y CONFIG_MAC80211=y"

# DTBO / Packaging
NEED_DTBO=true
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
